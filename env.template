# =============================================================================
# jarvis-recipes-server - Environment Template
# =============================================================================
# Copy to .env and fill in values
# Port: 7030
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jarvis_recipes

# For migrations (use localhost even when running in Docker)
MIGRATIONS_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jarvis_recipes

# -----------------------------------------------------------------------------
# AUTHENTICATION (if using internal JWT)
# -----------------------------------------------------------------------------
AUTH_SECRET_KEY=CHANGE_ME_generate_secure_key
AUTH_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=7030
HOST=0.0.0.0
# "production"/"prod" makes a weak or placeholder secret fatal at boot
JARVIS_ENV=development
# X-Admin-Secret for POST /admin/static-data/seed and /admin/static-recipes/seed
ADMIN_SECRET=CHANGE_ME_generate_secure_key

# -----------------------------------------------------------------------------
# SERVICE DISCOVERY + APP CREDENTIALS
# -----------------------------------------------------------------------------
# Source of truth for jarvis-auth / jarvis-ocr-service / jarvis-llm-proxy-api URLs
JARVIS_CONFIG_URL=http://localhost:7700
# Outbound app-to-app credentials (llm-proxy, OCR service, jarvis-logs)
JARVIS_APP_ID=jarvis-recipes-server
JARVIS_APP_KEY=CHANGE_ME
# Legacy direct URLs, used only when discovery misses
# JARVIS_AUTH_BASE_URL=http://localhost:7701
# JARVIS_OCR_SERVICE_URL=http://localhost:7031
# LLM_BASE_URL=http://localhost:7704

# -----------------------------------------------------------------------------
# OBJECT STORE (recipe image uploads)
# -----------------------------------------------------------------------------
# REQUIRED for "add a recipe from photos". Without S3_BUCKET the upload fails
# with "S3_BUCKET or RECIPE_IMAGE_S3_BUCKET must be configured" -- which reads
# like a missing service, but MinIO is already running: jarvis-data-services
# stands it up on 9000. What was missing is this block.
#
# The bucket is NOT created for you. Once, per environment:
#   docker run --rm --network host --entrypoint sh minio/mc:latest -c \
#     'mc alias set local http://localhost:9000 $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD &&
#      mc mb --ignore-existing local/jarvis-dev'
OBJECT_STORE_PROVIDER=minio
# host.docker.internal, not localhost: the API and worker run in containers,
# where localhost is the container. Use http://localhost:9000 only when running
# the server directly on the host.
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_BUCKET=jarvis-dev
S3_REGION=us-east-1
# True for MinIO, false for real AWS S3.
S3_FORCE_PATH_STYLE=true
# MinIO's root credentials, from jarvis-data-services/.env. Left as the literal
# local default (like postgres:postgres above) so a fresh checkout works without
# hand-configuration -- but the key NAME invites copying this file to a real
# deployment. Anything reachable from outside the host needs its own credentials
# here and in jarvis-data-services.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# OCR FAN-OUT
# -----------------------------------------------------------------------------
# Comma-separated OCR queues. Every image is sent to ALL of them and the readings
# are joined before the LLM structures them (services/ocr_join) -- the engines
# fail differently, so the model reconciles them better than any one reads.
# Each OCR host consumes its own queue via OCR_QUEUE_NAME.
#
# A single queue here is the original behaviour: one host, one reading, no wait.
OCR_QUEUES=jarvis.ocr.jobs
# How long to wait for slower hosts once the first has answered. Past this the
# import continues with whatever arrived, so a host that is asleep costs its
# reading and not the import.
OCR_JOIN_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# REDIS (async job queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# RUNTIME KNOBS
# -----------------------------------------------------------------------------
# These are settings-DB values (see services/settings_service.py and /settings/*).
# The env vars below are only the fallback used when there is no DB row, so
# prefer changing them in jarvis-admin.
# AUTH_ALGORITHM (auth.algorithm) is declared above.
# JARVIS_FULL_MODEL_NAME=live
# JARVIS_LIGHTWEIGHT_MODEL_NAME=live
# LLM_RECIPE_QUEUE_MAX_RETRIES=3
# RECIPE_PARSE_JOB_ABANDON_MINUTES=4320
# RECIPE_IMAGE_MAX_BYTES=10485760
# SCRAPER_USER_AGENT=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Console level for the API and the worker processes
JARVIS_LOG_CONSOLE_LEVEL=INFO
# Level shipped to jarvis-logs (requires JARVIS_APP_ID / JARVIS_APP_KEY)
JARVIS_LOG_REMOTE_LEVEL=INFO
